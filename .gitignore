# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# groundhog build/runtime artifacts
*.zip
last-run/
cache.json
manifest.json
# durable SQLite index (+ WAL/SHM siblings and quarantined corrupt copies) --
# holds mined session data; never commit
index.db
index.db-wal
index.db-shm
index.db.bak
*.bak
# analysis outputs may hold mined (best-effort-scrubbed) session data — never commit
scan.json
verdict.json
plan.json
env.json

# hookify local rules (never commit machine-local rules)
.claude/*.local.md

# OS junk
.DS_Store
Thumbs.db
